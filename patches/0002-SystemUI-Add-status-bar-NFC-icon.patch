From 28f422f188acfed8d1e70620389078a504be3370 Mon Sep 17 00:00:00 2001
From: Failedmush <anytimewicked@gmail.com>
Date: Wed, 23 Sep 2026 00:00:00 +0000
Subject: [PATCH] SystemUI: Add status bar NFC icon

---
 .../res/drawable/ic_statusbar_nfc.xml         | 10 ++++++++++
 .../SystemUI/res/drawable/stat_sys_nfc.xml    | 25 +++++++++++++++++++
 packages/SystemUI/res/values/cm_strings.xml   |  3 +++
 .../SystemUI/res/xml/status_bar_prefs.xml     |  5 +++++
 .../statusbar/phone/PhoneStatusBarPolicy.java | 23 +++++++++++++++++++
 5 files changed, 66 insertions(+)
 create mode 100644 packages/SystemUI/res/drawable/ic_statusbar_nfc.xml
 create mode 100644 packages/SystemUI/res/drawable/stat_sys_nfc.xml

diff --git a/packages/SystemUI/res/drawable/ic_statusbar_nfc.xml b/packages/SystemUI/res/drawable/ic_statusbar_nfc.xml
new file mode 100644
index 000000000000..16817c2cc69d
--- /dev/null
+++ b/packages/SystemUI/res/drawable/ic_statusbar_nfc.xml
@@ -0,0 +1,10 @@
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="24"
+    android:viewportHeight="24"
+    android:tint="?android:attr/colorControlNormal">
+  <path
+      android:fillColor="#FFFFFFFF"
+      android:pathData="M20 2H4c-1.1 0-2 .9-2 2v16c0 1.1 .9 2 2 2h16c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 18H4V4h16v16zM18 6h-5c-1.1 0-2 .9-2 2v2.28c-.6 .35 -1 .98-1 1.72 0 1.1 .9 2 2 2s2-.9 2-2c0-.74-.4-1.38-1-1.72V8h3v8H8V8h2V6H6v12h12V6z" />
+</vector>
diff --git a/packages/SystemUI/res/drawable/stat_sys_nfc.xml b/packages/SystemUI/res/drawable/stat_sys_nfc.xml
new file mode 100644
index 000000000000..09b4a29e6642
--- /dev/null
+++ b/packages/SystemUI/res/drawable/stat_sys_nfc.xml
@@ -0,0 +1,25 @@
