From 699542cb50521184bfbf52fcdc0a3c0fea1bad20 Mon Sep 17 00:00:00 2001
From: Failedmush <anytimewicked@gmail.com>
Date: Sat, 5 Sep 2026 09:24:01 +0000
Subject: [PATCH] config: Allow overriding WITH_GMS flag

---
 config/common.mk | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/config/common.mk b/config/common.mk
index 8efd81f..69d58ba 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -210,11 +210,12 @@ $(call inherit-product, vendor/certification/config.mk)
 include vendor/derp/config/version.mk
 
 # GApps
-WITH_GMS := true
+ifeq ($(WITH_GMS),true)
 $(call inherit-product, vendor/gms/products/gms.mk)
 
 # Pixel Framework
 $(call inherit-product, vendor/pixel-framework/config.mk)
+endif
 
 # Pixel customization
 TARGET_SUPPORTS_GOOGLE_RECORDER ?= true
